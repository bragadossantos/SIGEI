@page "/Account/Manage"

@using Microsoft.AspNetCore.Identity
@using Sigei.Domain
@using Sigei.Web.Data

@inject IdentityUserAccessor UserAccessor

<PageTitle>O meu perfil</PageTitle>

<h3>O meu perfil</h3>
<StatusMessage />

<dl class="row">
    <dt class="col-sm-3">Nome</dt>
    <dd class="col-sm-9">@(user.NomeCompleto ?? "—")</dd>
    <dt class="col-sm-3">Utilizador</dt>
    <dd class="col-sm-9">@user.UserName</dd>
    <dt class="col-sm-3">Perfil</dt>
    <dd class="col-sm-9">@RotuloPerfil</dd>
</dl>
<a class="btn btn-outline-primary" href="Account/Manage/ChangePassword">Alterar palavra-passe</a>

@code {
    private ApplicationUser user = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync() =>
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);

    private string RotuloPerfil => user.Perfil switch
    {
        PerfilUtilizador.AdminSaas => "Administrador da plataforma",
        PerfilUtilizador.Direcao => "Direção",
        PerfilUtilizador.Secretaria => "Secretaria",
        PerfilUtilizador.Professor => "Professor",
        PerfilUtilizador.Aluno => "Aluno",
        _ => "Encarregado de educação"
    };
}
