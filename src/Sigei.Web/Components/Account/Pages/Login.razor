@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using Sigei.Domain
@using Sigei.Web.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<Login> Logger
@inject IdentityRedirectManager RedirectManager

<PageTitle>Entrar</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <h1 class="h3 mb-1">Entrar no SIGEI</h1>
        <p class="text-muted">Alunos e encarregados entram com o número de telefone registado na escola.</p>
        <StatusMessage Message="@errorMessage" />
        <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Utilizador" id="Input.Utilizador" class="form-control" autocomplete="username" aria-required="true" placeholder="Telefone ou utilizador" />
                <label for="Input.Utilizador" class="form-label">Telefone ou utilizador</label>
                <ValidationMessage For="() => Input.Utilizador" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Palavra-passe" />
                <label for="Input.Password" class="form-label">Palavra-passe</label>
                <ValidationMessage For="() => Input.Password" class="text-danger" />
            </div>
            <div class="form-check mb-3">
                <InputCheckbox @bind-Value="Input.RememberMe" id="lembrar" class="form-check-input" />
                <label class="form-check-label" for="lembrar">Manter sessão iniciada neste dispositivo</label>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Entrar</button>
            <p class="mt-3 mb-0"><a href="Account/ForgotPassword">Esqueci a palavra-passe</a></p>
        </EditForm>
    </div>
</div>

@code {
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method))
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
    }

    public async Task LoginUser()
    {
        var utilizador = NomesDeUtilizador.Normalizar(Input.Utilizador);
        // Cinco tentativas falhadas bloqueiam a conta durante 15 minutos.
        var result = await SignInManager.PasswordSignInAsync(utilizador, Input.Password, Input.RememberMe, lockoutOnFailure: true);

        if (result.Succeeded)
        {
            Logger.LogInformation("Sessão iniciada por {Utilizador}.", utilizador);
            var user = await SignInManager.UserManager.FindByNameAsync(utilizador);
            if (user is { MudarPalavrapasse: true })
                RedirectManager.RedirectTo("Account/Manage/ChangePassword");
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("Conta bloqueada: {Utilizador}.", utilizador);
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            // Mensagem igual para utilizador inexistente e palavra-passe errada.
            errorMessage = "Erro: telefone/utilizador ou palavra-passe incorretos.";
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Indique o telefone ou o utilizador.")]
        public string Utilizador { get; set; } = "";

        [Required(ErrorMessage = "Indique a palavra-passe.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
