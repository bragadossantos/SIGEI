@page "/Account/Lockout"

<PageTitle>Conta bloqueada</PageTitle>

<header>
    <h1 class="h3 text-danger">Conta bloqueada</h1>
    <p role="alert">
        Depois de 5 tentativas falhadas, o acesso fica bloqueado durante 15 minutos. Se a conta foi desativada
        pela escola, fale com a secretaria ou a direção.
    </p>
    <a class="btn btn-primary" href="Account/Login">Voltar</a>
</header>
