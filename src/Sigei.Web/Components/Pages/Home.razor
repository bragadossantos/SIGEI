@page "/"
@inject IWebHostEnvironment Env

<PageTitle>SIGEI</PageTitle>

<h1>SIGEI</h1>
<p class="lead">Sistema Integrado de Gestão Escolar — Iniciação à 13.ª classe.</p>

<AuthorizeView>
    <Authorized>
        <p>Sessão iniciada como <strong>@context.User.Identity?.Name</strong>.</p>
        <AuthorizeView Policy="@Sigei.Web.Data.Politicas.DecidirAcessoNotas" Context="_">
            <a class="btn btn-primary" href="secretaria/acesso-notas">Acesso às notas</a>
        </AuthorizeView>
        <AuthorizeView Policy="@Sigei.Web.Data.Politicas.MembroDaEscola" Context="membro">
            <UltimosAnuncios />
        </AuthorizeView>
        <AuthorizeView Policy="@Sigei.Web.Data.Politicas.ConsultarNotas" Context="_">
            <a class="btn btn-primary" href="portal/notas">Ver notas</a>
        </AuthorizeView>
        <AuthorizeView Policy="@Sigei.Web.Data.Politicas.LancarNotas" Context="_">
            <a class="btn btn-primary" href="professor/notas">Lançar notas</a>
        </AuthorizeView>
    </Authorized>
    <NotAuthorized>
        <a class="btn btn-primary" href="Account/Login">Entrar</a>
    </NotAuthorized>
</AuthorizeView>

@if (Env.IsDevelopment())
{
    <div class="card mt-4" style="max-width: 36rem">
        <div class="card-header">Contas de demonstração (apenas em desenvolvimento)</div>
        <ul class="list-group list-group-flush">
            @foreach (var c in Sigei.Web.Data.DadosDemonstracao.Contas)
            {
                <li class="list-group-item"><strong>@c.Perfil</strong> — @c.Utilizador</li>
            }
            <li class="list-group-item"><strong>Administrador da plataforma</strong> — @Sigei.Web.Data.AdministradorInicial.UtilizadorDemonstracao (palavra-passe @Sigei.Web.Data.AdministradorInicial.PalavrapasseDemonstracao)</li>
            <li class="list-group-item text-muted">Palavra-passe das restantes contas: @Sigei.Web.Data.DadosDemonstracao.Palavrapasse</li>
        </ul>
    </div>
}
