<div class="col-6 col-lg-3">
    <div class="card h-100 cartao-@Tom">
        <div class="card-body py-3">
            <div class="small text-muted">@Titulo</div>
            <div class="fs-2 fw-semibold lh-1">@Valor</div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter, EditorRequired] public int Valor { get; set; }
    [Parameter] public string Tom { get; set; } = "neutro";
}
