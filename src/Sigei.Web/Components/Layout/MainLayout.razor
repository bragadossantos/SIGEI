@inherits LayoutComponentBase

<div class="faixa-angola" aria-hidden="true"></div>
<div class="page">
    <aside class="sidebar" aria-label="Menu principal">
        <NavMenu />
    </aside>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="small text-muted me-auto d-none d-sm-inline">Olá, @(context.User.FindFirst("sigei:perfil")?.Value switch
                    {
                        "Direcao" => "Direção",
                        "Secretaria" => "Secretaria",
                        "Professor" => "Professor",
                        "Aluno" => "Aluno",
                        "Encarregado" => "Encarregado",
                        "AdminSaas" => "Administrador",
                        _ => ""
                    })</span>
                    <a href="Account/Manage">@context.User.Identity?.Name</a>
                </Authorized>
                <NotAuthorized>
                    <a href="Account/Login">Entrar</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>
