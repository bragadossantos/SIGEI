@implements IDisposable

@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href=""><span class="estrela" aria-hidden="true">★</span> SIGEI</a>
    </div>
</div>

<input type="checkbox" title="Abrir ou fechar o menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Início
            </NavLink>
        </div>

        <AuthorizeView Policy="@Sigei.Web.Data.Politicas.DecidirAcessoNotas" Context="secretaria">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="secretaria/acesso-notas">
                    <span class="bi bi-lock-nav-menu" aria-hidden="true"></span> Acesso às notas
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@Sigei.Web.Data.Politicas.MembroDaEscola" Context="an1">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="anuncios">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Anúncios
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@Sigei.Web.Data.Politicas.PublicarAnuncios" Context="an2">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="direcao/anuncios">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Publicar anúncios
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@Sigei.Web.Data.Politicas.AdministrarPlataforma" Context="adm">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/escolas">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Escolas e licenças
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@Sigei.Web.Data.Politicas.GerirMatriculasETurmas" Context="m0">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="secretaria/matriculas">
                    <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Matrículas
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@Sigei.Web.Data.Politicas.GerirMatriculasETurmas" Context="m5">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="secretaria/acessos">
                    <span class="bi bi-lock-nav-menu" aria-hidden="true"></span> Acessos
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@Sigei.Web.Data.Politicas.AssociarDisciplinasATurmas" Context="m1">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="secretaria/turmas">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Turmas
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@Sigei.Web.Data.Politicas.GerirCurriculoDisciplinas" Context="m2">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="direcao/disciplinas">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Disciplinas
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@Sigei.Web.Data.Politicas.AbrirFecharAnoLetivo" Context="m4">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="direcao/ano-letivo">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Ano letivo
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@Sigei.Web.Data.Politicas.GerirDefinicoesEscola" Context="m6">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="direcao/pessoal">
                    <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Pessoal
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@Sigei.Web.Data.Politicas.GerirDefinicoesEscola" Context="m3">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="direcao/definicoes">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Definições
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@Sigei.Web.Data.Politicas.ConsultarNotas" Context="portal">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="portal/notas">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Notas
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@Sigei.Web.Data.Politicas.LancarNotas" Context="prof">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="professor/notas">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Lançar notas
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Terminar sessão
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Entrar
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

